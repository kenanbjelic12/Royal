; Engine configuration file.
config_version=5

[application]

config/name="Royal Arena"
config/description="3D card battle game - test build with 5 cards / 5 monsters"
run/main_scene="res://Scenes/MainMenu/MainMenu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0549, 0.0784, 0.1882, 1)
boot_splash/show_image=true
boot_splash/image="res://Assets/UI/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[autoload]

SettingsManager="*res://Scripts/SettingsManager.gd"
GameManager="*res://Scripts/GameManager.gd"
EconomyManager="*res://Scripts/EconomyManager.gd"
CardDatabase="*res://Scripts/Data/CardDatabase.gd"
AudioManager="*res://Scripts/AudioManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://Assets/UI/Fonts/LilitaOne.woff2"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]
mesh_lod/lod_change/threshold_pixels=6.0

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.2, 0.45, 0.25, 1)
